/* --- GLOBALE --- */
QMainWindow {
    background-color: #2b2b2b;
}

QLabel {
    color: #E0E0E0;
}

/* --- IMAGE --- */
MedicalImageVisualizer {
    background-color: #1a1a1a;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
}

#PlaceholderLabel {
    color: #888888;
    font-size: 15px;
    background-color: transparent;
}

/* --- TOP BAR --- */
TopToolbar {
    background-color: #202020;
    border-bottom: 1px solid #3c3c3c;
}

TopToolbar QPushButton {
    background-color: #3c3c3c;
    color: #E0E0E0;
    border: 1px solid #555555;
    border-radius: 4px;
}

TopToolbar QPushButton:hover {
    background-color: #4f4f4f;
    border: 1px solid #666666;
}
TopToolbar QPushButton:checked {
    background-color: #00a2ed;
    color: #FFFFFF;
    border: 1px solid #00a2ed;
}

/* --- LEFT BAR --- */
LeftToolbar {
    background-color: #202020;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
}

/* --- ONGLETS --- */
LeftToolbar QPushButton#SectionHeader {
    background-color: #4e4e4e;
    color: #FFFFFF;
    border: 1px solid #4e4e4e; /* Écrase le style Windows natif */
    border-radius: 0px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: bold;
    text-align: left;
}

LeftToolbar QPushButton#SectionHeader:checked {
    background-color: #00a2ed; 
    border: 1px solid #00a2ed;
}

LeftToolbar QWidget QPushButton {
    background-color: #3c3c3c;
    color: #E0E0E0;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 0px;
    margin: 0px;
}

LeftToolbar QWidget QPushButton:hover {
    background-color: #4f4f4f;
    border: 1px solid #666666;
}

LeftToolbar QWidget QPushButton:checked,
LeftToolbar QWidget QPushButton:pressed {
    background-color: #00a2ed; 
    color: #FFFFFF;
    border: 1px solid #00a2ed;
}
#MagnifierLens {
    background-color: #000000;
    border: 2px solid #ffffff;
    border-radius: 0px; /* Carré parfait */
}

/* affiche le texte de description pour les boutons */
QToolTip {
    background-color: #3c3c3c;
    color: #E0E0E0;
    border: 1px solid #555555;
    border-radius: 2px;
    padding: 2px 4px;
}

/* === STYLE DE LA POP-UP CRÉATION PATIENT === */

QDialog#PatientDialog {
    background-color: #2b2b2b;
}

QDialog#PatientDialog QLabel {
    color: #ffffff;
    font-weight: bold;
    background-color: transparent;
}

QDialog#PatientDialog QLineEdit, 
QDialog#PatientDialog QComboBox {
    background-color: #3b3b3b;
    color: #ffffff;
    border: 1px solid #555555;
    border-radius: 3px;
    padding: 5px;
}

QDialog#PatientDialog QLineEdit:focus, 
QDialog#PatientDialog QComboBox:focus {
    border: 1px solid #00a2ed;
}

QDialog#PatientDialog QPushButton {
    background-color: #00a2ed;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: bold;
    margin-top: 5px;
}

QDialog#PatientDialog QPushButton:hover {
    background-color: #0082bc;
}
QPushButton#PatientInfoCloseBtn {
    background-color: transparent;
    color: #888888;
    border: none;
    font-size: 11px;
    font-weight: bold;
    border-radius: 3px;
    padding: 0px;
}

QPushButton#PatientInfoCloseBtn:hover {
    background-color: #d32f2f; /* Rouge médical au survol */
    color: #ffffff;
}

/* === STYLE DE LA POP-UP CALIBRATION RATIO === */

/* Fenêtre de dialogue modale de calibration */
QDialog#RatioCalibrationDialog {
    background-color: #202020;
    border: 1px solid #3c3c3c;
    border-radius: 8px;
}

/* Libellés de texte dans le dialogue */
QDialog#RatioCalibrationDialog QLabel {
    color: #e0e0e0;
    font-size: 12px;
}

/* SpinBox numérique pour le ratio personnalisé */
QDialog#RatioCalibrationDialog QDoubleSpinBox {
    background-color: #2b2b2b;
    color: #ffffff;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 5px;
    min-width: 120px;
}

QDialog#RatioCalibrationDialog QDoubleSpinBox:focus {
    border: 1px solid #00a2ed;
}

/* Liste déroulante des préréglages */
QDialog#RatioCalibrationDialog QComboBox {
    background-color: #2b2b2b;
    color: #ffffff;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 5px;
    min-width: 180px;
}

QDialog#RatioCalibrationDialog QComboBox:focus {
    border: 1px solid #00a2ed;
}

/* Bouton Appliquer (style standard) */
QDialog#RatioCalibrationDialog QPushButton {
    background-color: #00a2ed;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 12px;
}

QDialog#RatioCalibrationDialog QPushButton:hover {
    background-color: #0082bc;
}

QDialog#RatioCalibrationDialog QPushButton:pressed {
    background-color: #006896;
}

QDialog#RatioCalibrationDialog QPushButton#CancelBtn {
    background-color: #3a3a3a;
    color: #ffffff;
}

QDialog#RatioCalibrationDialog QPushButton#CancelBtn:hover {
    background-color: #4a4a4a;
}

/* === STYLE DES BOÎTES DE DIALOGUE GLOBALES (QDialog, QMessageBox, QInputDialog) === */

QDialog, QMessageBox, QInputDialog {
    background-color: #2b2b2b;
    color: #ffffff;
}

QDialog QLabel, QMessageBox QLabel, QInputDialog QLabel {
    color: #ffffff;
    font-size: 12px;
}

QDialog QLineEdit, QInputDialog QLineEdit, QDialog QDoubleSpinBox, QDialog QSpinBox, QDialog QComboBox {
    background-color: #3b3b3b;
    color: #ffffff;
    border: 1px solid #555555;
    border-radius: 3px;
    padding: 5px;
    font-size: 12px;
}

QDialog QLineEdit:focus, QInputDialog QLineEdit:focus, QDialog QDoubleSpinBox:focus, QDialog QSpinBox:focus, QDialog QComboBox:focus {
    border: 1px solid #00a2ed;
}

QDialog QPushButton, QMessageBox QPushButton, QInputDialog QPushButton {
    background-color: #3c3c3c;
    color: #E0E0E0;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 11px;
    font-weight: bold;
    min-width: 75px;
}

QDialog QPushButton:hover, QMessageBox QPushButton:hover, QInputDialog QPushButton:hover {
    background-color: #4f4f4f;
    border: 1px solid #666666;
}

/* Style de mise en valeur pour le bouton principal / acceptation */
QDialog QPushButton:default, QMessageBox QPushButton:default, QInputDialog QPushButton:default {
    background-color: #00a2ed;
    color: #ffffff;
    border: 1px solid #00a2ed;
}

QDialog QPushButton:default:hover, QMessageBox QPushButton:default:hover, QInputDialog QPushButton:default:hover {
    background-color: #0082bc;
    border: 1px solid #0082bc;
}

QDialog QPushButton:pressed, QMessageBox QPushButton:pressed, QInputDialog QPushButton:pressed {
    background-color: #006896;
    color: #ffffff;
    border: 1px solid #006896;
}